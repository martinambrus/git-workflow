 /**
- * Alter the sponsorship banner before it is rendered (since 1.1.0).
+ * Alter the sponsorship banner before it is rendered (2.0.0: renamed from hook_ait_banners_banner_alter()).
  *
  * @param array $build
  *   The render array of the banner (theme ait_banners_banner).
- * @param array $configuration
- *   The block configuration: sponsor, tagline, url, image_url, promo.
+ * @param \Drupal\Core\Block\BlockPluginInterface $block
+ *   The block plugin (use getConfiguration()).
  */
-function hook_ait_banners_banner_alter(array &$build, array $configuration): void {
+function hook_ait_banners_render_alter(array &$build, $block): void {
   $build['#prefix'] = '<div class="my-wrapper">';
   $build['#suffix'] = '</div>';
 }
