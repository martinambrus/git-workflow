#!/bin/bash
# Entry point for the git-workflow lab. Run ./lab help
set -euo pipefail
ROOT=$(cd "$(dirname "$0")" && pwd)
. "$ROOT/ops/bin/lib.sh"
cmd=${1:-help}; shift || true
case $cmd in
  up)       "$ROOT/ops/bin/bootstrap.sh"; "$ROOT/ops/bin/sync.sh"
            echo; echo "Gitea    http://gitea.test:3000   admin/admin12345  (bot/bot12345, dev/dev12345)"
            echo "Packeton http://packeton.test     admin/admin12345"
            hosts_ok || echo "NOTE: run ./lab hosts once, then ./lab sync to clone the repos" ;;
  sync)     "$ROOT/ops/bin/sync.sh" "$@" ;;
  hosts)    if hosts_ok; then echo "already resolvable"; else
              echo "127.0.0.1 gitea.test packeton.test" | sudo tee -a /etc/hosts; fi ;;
  status)   dc ps; echo; hosts_ok && echo "hosts: ok" || echo "hosts: gitea.test/packeton.test do not resolve (./lab hosts)";;
  logs)     dc logs -f --tail 50 "$@" ;;
  down)     dc down ;;
  destroy)  read -r -p "Delete ALL lab data (Gitea repos, Packeton, runner, ops/.state, ops/.env)? [y/N] " a
            [ "$a" = y ] && { dc --profile build down -v; rm -rf "$OPS/.state" "$OPS/.env"; echo "destroyed. Local clones in modules/ and projects/ are kept; delete them by hand."; } ;;
  reset)    "$0" destroy && "$0" up ;;
  site)     "$ROOT/ops/bin/site-up.sh" "${1:-all}" ;;
  smoke)    "$ROOT/ops/bin/smoke.sh" "$@" ;;
  composer) # composer inside the runner image, on the lab network, with Packeton credentials preloaded
            load_secrets; mkdir -p "$STATE/composer-home"
            echo '{"config":{"secure-http":false}}' > "$STATE/composer-home/config.json"
            echo "{\"http-basic\":{\"packeton.test\":{\"username\":\"admin\",\"password\":\"$PACKETON_TOKEN\"}}}" > "$STATE/composer-home/auth.json"
            exec docker run --rm -i $([ -t 0 ] && echo -t) --network wf-net --user "$(id -u):$(id -g)" \
              -e COMPOSER_HOME=/composer-home -e HOME=/tmp -v "$STATE/composer-home:/composer-home" \
              -v "$PWD:/app" -w /app activit-runner:local composer "$@" ;;
  *)        cat <<'H'
./lab up        build + start Gitea, Packeton, runner; configure them; create/clone repos from lab.manifest
./lab sync      re-apply lab.manifest (new repos, hooks, Packeton registration, clone or pull)  [sync <name>]
./lab hosts     add gitea.test / packeton.test to /etc/hosts (needs sudo, once)
./lab status    containers + name resolution
./lab site [name]  start DDEV site(s); installs from committed config/sync if there is no database yet
./lab smoke     end-to-end self-test of the stack (repo, tag, webhook, Actions job, composer)
./lab composer  run Composer (PHP 8.3 image on the lab network; no PHP needed on the host)
./lab logs [svc]  follow logs;  ./lab down  stop;  ./lab destroy  delete all lab data;  ./lab reset  destroy + up
H
            ;;
esac
