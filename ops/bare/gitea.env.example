# Extra Gitea settings, applied when the container is (re)created:
#   docker compose --project-directory ops/bare -f ops/bare/docker-compose.yml up -d gitea
# One KEY=value per line, no quotes. The guide tells you which ones to add and when (Phase 2). Do not add them
# before you reach that step: each one is part of what the ops team needs to learn and screenshot.
#
# GITEA__actions__ENABLED=true
# GITEA__security__EGRESS_MODE=lax
# GITEA__security__ALLOWED_HOST_LIST=private,loopback
# GITEA__repository__DEFAULT_BRANCH=main
# GITEA__service__DISABLE_REGISTRATION=true
